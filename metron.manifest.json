{
  "manifestVersion": "1.0.0",
  "project": {
    "name": "Metron",
    "subtitle": "Daily Energy, Readiness, & Caloric Allowance",
    "description": "An open-source, headless-first instrument for transparent fitness energy estimates and exploratory recovery decisions.",
    "license": "MIT",
    "repositoryTarget": "https://github.com/andydrewie/metron",
    "repositoryPublished": true,
    "pagesTarget": "https://andydrewie.github.io/metron/",
    "pagesVerifiedLive": true,
    "packageVersion": "0.2.0-alpha.3",
    "modelVersion": "0.1.0",
    "maturity": "public-exploratory-alpha"
  },
  "runtime": {
    "language": "JavaScript",
    "moduleFormat": "ESM",
    "nodeMinimumMajor": 20,
    "runtimeDependencies": 0,
    "requiresNetworkToCalculate": false,
    "requiresAccountsToCalculate": false
  },
  "entrypoints": {
    "core": "./core/model.js",
    "types": "./core/model.d.ts",
    "cli": "./bin/metron.mjs",
    "web": "./index.html",
    "inputSchema": "./schemas/input.schema.json",
    "outputSchema": "./schemas/output.schema.json",
    "agentInstructions": "./AGENTS.md",
    "apiDocumentation": "./docs/API.md",
    "scientificMethods": "./docs/SCIENCE.md",
    "researchProtocol": "./research/protocol.json",
    "researchOverview": "./research/README.md",
    "designTokens": "./design/tokens.json",
    "designCss": "./design/tokens.css",
    "roadmap": "./docs/ROADMAP.md",
    "informationDesign": "./docs/INFORMATION_DESIGN.md",
    "navigationIndex": "./docs/navigation.json",
    "collaborationPolicy": "./docs/COLLABORATION.md",
    "decisionIndex": "./docs/adr/index.json",
    "vocabulary": "./docs/VOCABULARY.md",
    "decisionTemplate": "./docs/adr/TEMPLATE.md",
    "claudeAgentInstructions": "./CLAUDE.md",
    "copilotAgentInstructions": "./.github/copilot-instructions.md",
    "energyAccountingResearch": "./research/energy-accounting/README.md",
    "energyAccountingFixtures": "./research/energy-accounting/scenarios.json",
    "activityEventsResearch": "./research/activity-events/README.md",
    "activityEventsSchema": "./research/activity-events/contract.schema.json",
    "providerStepSemanticsResearch": "./research/provider-step-semantics/README.md",
    "providerStepSemanticsMatrix": "./research/provider-step-semantics/matrix.json",
    "appleHealthKitLocalPilot": "./research/apple-healthkit-pilot/README.md",
    "appleHealthKitXcodeProject": "./research/apple-healthkit-pilot/HealthPilot.xcodeproj/project.pbxproj",
    "assumptionSensitivityResearch": "./research/assumption-sensitivity/README.md",
    "assumptionSensitivityFixtures": "./research/assumption-sensitivity/fixtures.json",
    "rmrValidationProgram": "./research/ree-validation/README.md",
    "rmrValidationPlan": "./research/ree-validation/plan.json",
    "rmrValidationCandidates": "./research/ree-validation/candidate-sources.json",
    "rmrValidationG0Audit": "./research/ree-validation/G0_SOURCE_AUDIT.md",
    "rmrValidationG0Evidence": "./research/ree-validation/G0_FILE_VERIFICATION.json",
    "rmrValidationFrozenProtocol": "./research/ree-validation/protocol.v1.json",
    "rmrValidationG1Summary": "./research/ree-validation/G1_FROZEN_PROTOCOL.md",
    "rmrValidationBenchmark": "./research/ree-validation/benchmark.mjs",
    "rmrValidationHeadlessCli": "./research/ree-validation/run.mjs",
    "rmrValidationG2Guide": "./research/ree-validation/G2_BENCHMARK.md",
    "rmrValidationResults": "./research/ree-validation/G3_RESULTS.md",
    "rmrValidationAggregateResults": "./research/ree-validation/results/g3-enable-v1.json",
    "rmrValidationDecision": "./research/ree-validation/G4_DECISION.md",
    "restingModelDecisionRecord": "./docs/adr/0005-retain-resting-default-pending-replication.md",
    "durableEvidenceProgram": "./research/robustness/README.md",
    "robustnessPlan": "./research/robustness/plan.json",
    "researchCorpus": "./research/robustness/corpus.json",
    "corpusAudit": "./research/robustness/audit.mjs",
    "continuation": "./docs/CONTINUE.md",
    "claimInventory": "./research/robustness/inventory.json",
    "claimApplicability": "./research/robustness/applicability.json",
    "semanticContract": "./research/robustness/semantics.json",
    "claimLookup": "./research/robustness/inspect.mjs",
    "H1Report": "./research/robustness/H1_INVENTORY.md",
    "evidenceReviewQueue": "./research/robustness/h2-review-queue.json",
    "readinessEvidenceReview": "./research/robustness/h2a/README.md",
    "readinessReviewRecords": "./research/robustness/h2a/review.json",
    "readinessReviewSources": "./research/robustness/h2a/sources.json",
    "readinessReviewSearches": "./research/robustness/h2a/search-log.json",
    "readinessRuleAudit": "./research/robustness/h2a/rule-audit.json"
  },
  "implemented": {
    "energyEstimate": true,
    "energyComponents": [
      "baselineKcal",
      "walkingKcal",
      "workoutKcal"
    ],
    "restingModels": [
      "mifflin",
      "cunningham"
    ],
    "readinessHeuristic": true,
    "bodyCompositionInputs": [
      "bodyFatPercent",
      "skeletalMuscleKg"
    ],
    "cliJson": true,
    "esmSdk": true,
    "interactiveStaticWeb": true,
    "caloricAllowance": false,
    "wearableParsers": false,
    "wearableOAuth": false,
    "bayesianCalibration": false,
    "mcpServer": false,
    "empiricallyValidatedReadiness": false,
    "calibratedIndividualUncertainty": false,
    "activityOverlapReconciliation": false
  },
  "methodCaveats": [
    "population-estimation-not-individual-measurement",
    "walking-and-workout-estimates-may-overlap",
    "readiness-set-ranges-are-unvalidated-coaching-heuristics",
    "unit-tests-are-not-biological-validation"
  ],
  "agentQuickstart": {
    "check": "npm run ci",
    "example": "node bin/metron.mjs --file examples/beginner.json",
    "stdin": "cat examples/beginner.json | node bin/metron.mjs"
  },
  "researchPrototypes": {
    "appleHealthKitOnDevicePilot": {
      "sourceAvailable": true,
      "simulatorBuildVerified": true,
      "realDeviceDataCollected": false,
      "productionIntegration": false,
      "requiresExplicitOnDevicePermission": true,
      "simulatorBuildEvidence": "https://github.com/andydrewie/metron/actions/runs/42156958864"
    },
    "rmrExternalValidation": {
      "studyId": "RMR-EXT-001",
      "status": "published",
      "measuredDataAnalyzed": true,
      "empiricalResultsPublished": true,
      "productionIntegration": false,
      "dashboard": "https://github.com/andydrewie/metron/issues/9",
      "frozenProtocol": "research/ree-validation/protocol.v1.json",
      "syntheticEngineAvailable": true,
      "realDataRequiresExplicitG3": true,
      "nextGate": null,
      "empiricalValidationScope": "single-source-reanalysis-of-fixed-RMR-equations",
      "decisionGateComplete": true,
      "decision": "retain-default-with-population-and-input-quality-guidance",
      "decisionArtifact": "research/ree-validation/G4_DECISION.md",
      "independentCohortReplicationCompleted": false
    }
  },
  "researchPrograms": {
    "durableEvidence": {
      "programId": "METRON-ROBUST-001",
      "plan": "research/robustness/plan.json",
      "corpus": "research/robustness/corpus.json",
      "dashboard": "https://github.com/andydrewie/metron/issues/22",
      "statusAuthority": "research/robustness/plan.json",
      "clinicalCoverage": "explicit-context-map-clinical-evidence-unreviewed",
      "automaticMonitoringEnabled": false,
      "productionIntegration": false,
      "boundedEvidenceReviews": [
        "H2-A",
        "H2-B"
      ]
    }
  }
}
