  "asOf": "2026-11-07",
  "externalTerminologyMappings": [],
  "externalMappingDecision": "No external codes or equivalence mappings adopted. WHO/ICF and PROV-O remain design references only. Adopting a mapping requires exact identifier, relation type (not automatic equivalence), source version, inspected terms/license, reviewer and date. Empty mappings do not claim compliance.",
  "axes": [
    {
      "id": "clinical",
      "meaning": "Condition-specific scope; no complete diagnostic taxonomy asserted"
    },
    {
      "id": "life-stage",
      "meaning": "Age, pregnancy/lactation and other physiological contexts, not automatically pathology"
    },
    {
      "id": "function",
      "meaning": "Mobility/gait and functional limitations separate from diagnosis"
    },
    {
      "id": "treatment",
      "meaning": "Medication and treatment identity, exposure and timing remain source-specific"
    },
    {
      "id": "measurement",
      "meaning": "Method/device/preparation/reference and reporting window"
    },
    {
      "id": "model",
      "meaning": "Missingness, proxy error, overlapping membership, statistical uncertainty and implementation faults"
    },
    {
      "id": "intersection",
      "meaning": "Explicit combination with its own evidence state, not inherited validity"
    }
  ],
  "temporalContract": {
    "rmr": "Daily rate under a named resting protocol; not a day-long measured total",
    "tdee": "Estimated daily expenditure; not intake allowance",
    "walking": "Supplied daily steps, reporting timezone and source absent",
    "workout": "Whole-session elapsed duration; daily membership and overlap unverified",
    "readiness": "Current sleep/energy/comfort plus categorical past-week fatigue; no timestamps",
    "sets": "Per target muscle per session",
    "study": "Frozen study-specific measurement and analysis windows; preserve protocol",
    "future": "Proposed rolling windows do not exist in the current API"
  },
  "observationContract": [
    "Input values can be measured, self-reported, estimated or defaulted; current schema does not preserve that distinction.",
    "Missing measurement metadata are unknown, not proof of standard protocol.",
    "Schema numeric bounds and equation-sex categories do not establish clinical eligibility.",
    "Clinical exclusions are documented, not enforced by disease/treatment detection."
  ],
