{
  "manifestVersion": "1.0.0",
  "project": {
    "name": "Metron",
    "subtitle": "Daily Energy, Readiness, & Caloric Allowance",
    "description": "An open-source, headless-first instrument for transparent fitness energy estimates and exploratory recovery decisions.",
    "license": "MIT",
    "repositoryTarget": "https://github.com/andydrewie/metron",
    "repositoryPublished": true,
    "pagesTarget": "https://andydrewie.github.io/metron/",
    "pagesVerifiedLive": true,
    "packageVersion": "0.2.0-alpha.3",
    "modelVersion": "0.1.0",
    "maturity": "public-exploratory-alpha"
  },
  "runtime": {
    "language": "JavaScript",
    "moduleFormat": "ESM",
    "nodeMinimumMajor": 20,
    "runtimeDependencies": 0,
    "requiresNetworkToCalculate": false,
    "requiresAccountsToCalculate": false
  },
  "entrypoints": {
    "core": "./core/model.js",
    "types": "./core/model.d.ts",
    "cli": "./bin/metron.mjs",
    "web": "./index.html",
    "inputSchema": "./schemas/input.schema.json",
    "outputSchema": "./schemas/output.schema.json",
    "agentInstructions": "./AGENTS.md",
    "apiDocumentation": "./docs/API.md",
    "scientificMethods": "./docs/SCIENCE.md",
    "researchProtocol": "./research/protocol.json",
    "researchOverview": "./research/README.md",
    "designTokens": "./design/tokens.json",
    "designCss": "./design/tokens.css",
    "roadmap": "./docs/ROADMAP.md",
    "informationDesign": "./docs/INFORMATION_DESIGN.md",
    "navigationIndex": "./docs/navigation.json",
    "collaborationPolicy": "./docs/COLLABORATION.md",
    "decisionIndex": "./docs/adr/index.json",
    "vocabulary": "./docs/VOCABULARY.md",
    "decisionTemplate": "./docs/adr/TEMPLATE.md",
    "claudeAgentInstructions": "./CLAUDE.md",
    "copilotAgentInstructions": "./.github/copilot-instructions.md",
    "energyAccountingResearch": "./research/energy-accounting/README.md",
    "energyAccountingFixtures": "./research/energy-accounting/scenarios.json",
    "activityEventsResearch": "./research/activity-events/README.md",
    "activityEventsSchema": "./research/activity-events/contract.schema.json",
    "providerStepSemanticsResearch": "./research/provider-step-semantics/README.md",
    "providerStepSemanticsMatrix": "./research/provider-step-semantics/matrix.json",
    "appleHealthKitLocalPilot": "./research/apple-healthkit-pilot/README.md",
    "appleHealthKitXcodeProject": "./research/apple-healthkit-pilot/HealthPilot.xcodeproj/project.pbxproj"
  },
  "implemented": {
    "energyEstimate": true,
    "energyComponents": [
      "baselineKcal",
      "walkingKcal",
      "workoutKcal"
    ],
    "restingModels": [
      "mifflin",
      "cunningham"
    ],
    "readinessHeuristic": true,
    "bodyCompositionInputs": [
      "bodyFatPercent",
      "skeletalMuscleKg"
    ],
    "cliJson": true,
    "esmSdk": true,
    "interactiveStaticWeb": true,
    "caloricAllowance": false,
    "wearableParsers": false,
    "wearableOAuth": false,
    "bayesianCalibration": false,
    "mcpServer": false,
    "empiricallyValidatedReadiness": false,
    "calibratedIndividualUncertainty": false,
    "activityOverlapReconciliation": false
  },
  "methodCaveats": [
    "population-estimation-not-individual-measurement",
    "walking-and-workout-estimates-may-overlap",
    "readiness-set-ranges-are-unvalidated-coaching-heuristics",
    "unit-tests-are-not-biological-validation"
  ],
  "agentQuickstart": {
    "check": "npm run ci",
    "example": "node bin/metron.mjs --file examples/beginner.json",
    "stdin": "cat examples/beginner.json | node bin/metron.mjs"
  },
  "researchPrototypes": {
    "appleHealthKitOnDevicePilot": {
      "sourceAvailable": true,
      "simulatorBuildVerified": true,
      "realDeviceDataCollected": false,
      "productionIntegration": false,
      "requiresExplicitOnDevicePermission": true,
      "simulatorBuildEvidence": "https://github.com/andydrewie/metron/actions/runs/42156958864"
    }
  }
}
