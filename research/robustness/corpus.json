  "concepts": [
    {
      "id": "rmr",
      "label": "Resting metabolic rate",
      "definition": "Energy expenditure under a specified resting measurement protocol; do not silently equate different preparation conditions.",
      "units": "kcal/day",
      "definitionReview": "pending-H1",
      "externalMappings": []
    },
    {
      "id": "ree",
      "label": "Resting energy expenditure",
      "definition": "Resting energy endpoint with source-specific operational definition; map to RMR only after method review.",
      "units": "kcal/day",
      "definitionReview": "pending-H1",
      "externalMappings": []
    },
    {
      "id": "tdee",
      "label": "Total daily energy expenditure",
      "definition": "Whole-day expenditure endpoint, distinct from resting energy or an intake target.",
      "units": "kcal/day",
      "definitionReview": "pending-H1",
      "externalMappings": []
    },
    {
      "id": "baseline",
      "label": "Sedentary baseline",
      "definition": "Current model assumption allocating 1.2 times resting energy; not measured resting expenditure.",
      "units": "kcal/day",
      "definitionReview": "pending-H1",
      "externalMappings": []
    },
    {
      "id": "walking",
      "label": "Incremental walking energy",
      "definition": "Modeled energy above the assumed included steps, with explicit stride and net-cost assumptions.",
      "units": "kcal/day",
      "definitionReview": "pending-H1",
      "externalMappings": []
    },
    {
      "id": "workout",
      "label": "Workout energy",
      "definition": "Current whole-session MET estimate net of an allocated baseline; membership of steps remains separate.",
      "units": "kcal/day",
      "definitionReview": "pending-H1",
      "externalMappings": []
    },
    {
      "id": "ffm",
      "label": "Fat-free mass",
      "definition": "Nonfat body mass, with method and conditions required; not identical to skeletal muscle mass.",
      "units": "kg",
      "definitionReview": "pending-H1",
      "externalMappings": []
    },
    {
      "id": "smm",
      "label": "Skeletal muscle mass",
      "definition": "A component of FFM, not an independent calorie bonus or sufficient body-fat measurement.",
      "units": "kg",
      "definitionReview": "pending-H1",
      "externalMappings": []
    },
    {
      "id": "body-fat",
      "label": "Body-fat percentage",
      "definition": "A measured or estimated input whose method and uncertainty must be retained.",
      "units": "percentage points for changes; percent for levels",
      "definitionReview": "pending-H1",
      "externalMappings": []
    },
    {
      "id": "readiness",
      "label": "Training readiness",
      "definition": "Current heuristic classification; requires a specified outcome before predictive validation.",
      "units": "categorical",
      "definitionReview": "pending-H1",
      "externalMappings": []
    },
    {
      "id": "allowance",
      "label": "Caloric allowance",
      "definition": "A proposed goal-dependent intake decision, not equal to measured or estimated TDEE.",
      "units": "kcal/day if implemented",
      "definitionReview": "pending-H1",
      "externalMappings": []
    },
    {
      "id": "sdnn",
      "label": "SDNN",
      "definition": "A specific HRV statistic; preserve measurement window and provider method.",
      "units": "ms",
      "definitionReview": "pending-H1",
      "externalMappings": []
    },
    {
      "id": "rmssd",
      "label": "RMSSD",
      "definition": "A distinct HRV statistic; not interchangeable with SDNN because units match.",
      "units": "ms",
      "definitionReview": "pending-H1",
      "externalMappings": []
    },
    {
      "id": "membership",
      "label": "Activity membership",
      "definition": "Evidence that a sample contributes to a defined aggregate; temporal overlap alone is insufficient.",
      "units": "relation",
      "definitionReview": "pending-H1",
      "externalMappings": []
    },
    {
      "id": "cohort-interval",
      "label": "Cohort confidence interval",
      "definition": "Sampling uncertainty for a defined aggregate under a resampling/analysis method.",
      "units": "endpoint-specific",
      "definitionReview": "pending-H1",
      "externalMappings": []
    },
    {
      "id": "individual-interval",
      "label": "Individual prediction interval",
      "definition": "Uncertainty for a new individual observation; requires evaluation of predictive coverage.",
      "units": "endpoint-specific",
      "definitionReview": "pending-H1",
      "externalMappings": []
    }
  ],
